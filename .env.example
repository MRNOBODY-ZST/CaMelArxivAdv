# Runtime mode
APP_ENV=development
ALLOW_LIVE_SMTP=false
APP_PERSISTENCE_ENABLED=true
PUBLIC_BASE_URL=http://localhost:8080

# PostgreSQL (development values only; replace in deployed environments)
POSTGRES_DB=camel_arxiv
POSTGRES_USER=camel
POSTGRES_PASSWORD=change-this-for-local-development
POSTGRES_PORT=5432

# Redis and RabbitMQ
REDIS_PORT=6379
RABBITMQ_USER=camel
RABBITMQ_PASSWORD=change-this-for-local-development
RABBITMQ_MANAGEMENT_PORT=15672

# MinIO
MINIO_ROOT_USER=camelminio
MINIO_ROOT_PASSWORD=change-this-for-local-development
MINIO_CONSOLE_PORT=9001

# Application secrets: run `openssl rand -base64 32` separately for every value; never reuse output.
APP_ENCRYPTION_KEY_BASE64=
APP_EMAIL_HMAC_KEY_BASE64=
JWT_SIGNING_KEY_BASE64=
AUTH_FINGERPRINT_HMAC_KEY_BASE64=

# arXiv requires a descriptive user agent with a monitored contact address.
ARXIV_CONTACT_EMAIL=admin@example.invalid
ARXIV_MIN_REQUEST_INTERVAL=PT3S
ARXIV_PREVIEW_CACHE_TTL=PT24H
ARXIV_SOURCE_MAX_ARCHIVE_BYTES=52428800
ARXIV_SOURCE_MAX_EXTRACTED_BYTES=262144000
ARXIV_SOURCE_MAX_SINGLE_FILE_BYTES=20971520
ARXIV_SOURCE_MAX_FILE_COUNT=5000
ARXIV_SOURCE_MAX_COMPRESSION_RATIO=100
TRACKING_SIGNING_KEY_BASE64=
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=admin@example.invalid
INITIAL_ADMIN_DISPLAY_NAME=Administrator
INITIAL_ADMIN_PASSWORD=

# Authentication policy
AUTH_ACCESS_TOKEN_TTL=PT10M
AUTH_REFRESH_TOKEN_TTL=P14D
AUTH_MAX_LOGIN_FAILURES=5
AUTH_LOGIN_FAILURE_WINDOW=PT15M
AUTH_ISSUER=camel-arxiv
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAME_SITE=Strict

# Public ports
HTTP_PORT=8080
MAILPIT_WEB_PORT=8025
