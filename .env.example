# Runtime mode
APP_ENV=development
ALLOW_LIVE_SMTP=true
ALLOW_PUBLIC_MAILBOX=true
APP_PERSISTENCE_ENABLED=true
PUBLIC_BASE_URL=http://localhost:8080

# PostgreSQL (development values only; replace in deployed environments)
POSTGRES_DB=camel_arxiv
POSTGRES_USER=camel
POSTGRES_PASSWORD=change-this-for-local-development
POSTGRES_PORT=5432

# Redis and Kafka
REDIS_PORT=6379

# MinIO
MINIO_ROOT_USER=camelminio
MINIO_ROOT_PASSWORD=change-this-for-local-development
MINIO_CONSOLE_PORT=9001
TEMPLATE_ASSET_BUCKET=template-assets
TEMPLATE_ASSET_MAX_BYTES=5242880
TEMPLATE_MAX_CONTENT_BYTES=102400

# Mail protocol policy. Public destinations require STARTTLS or implicit TLS;
# PLAIN_LOCAL_ONLY is accepted only for the exact local allowlists below.
SMTP_LOCAL_ALLOWED_HOSTS=mailpit,mail-test,localhost,127.0.0.1
SMTP_CONNECT_TIMEOUT=PT5S
SMTP_READ_TIMEOUT=PT10S
SMTP_WRITE_TIMEOUT=PT10S
MAILBOX_LOCAL_ALLOWED_HOSTS=mail-test,localhost,127.0.0.1
MAILBOX_CONNECT_TIMEOUT=PT5S
MAILBOX_READ_TIMEOUT=PT10S
MAILBOX_MAX_PREVIEW_MESSAGES=50

# Application secrets: run `openssl rand -base64 32` separately for every value; never reuse output.
APP_ENCRYPTION_KEY_BASE64=
APP_EMAIL_HMAC_KEY_BASE64=
TEMPLATE_ASSET_SIGNING_KEY_BASE64=
JWT_SIGNING_KEY_BASE64=
AUTH_FINGERPRINT_HMAC_KEY_BASE64=

# arXiv requires a descriptive user agent with a monitored contact address.
ARXIV_CONTACT_EMAIL=admin@example.invalid
ARXIV_MIN_REQUEST_INTERVAL=PT3S
ARXIV_PREVIEW_CACHE_TTL=PT24H
ARXIV_SOURCE_MAX_ARCHIVE_BYTES=52428800
ARXIV_SOURCE_MAX_EXTRACTED_BYTES=262144000
ARXIV_SOURCE_MAX_SINGLE_FILE_BYTES=20971520
ARXIV_SOURCE_MAX_FILE_COUNT=5000
ARXIV_SOURCE_MAX_COMPRESSION_RATIO=100
TRACKING_SIGNING_KEY_BASE64=
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=admin@example.invalid
INITIAL_ADMIN_DISPLAY_NAME=Administrator
INITIAL_ADMIN_PASSWORD=

# Personalized draft generation. Keep disabled until OPENAI_API_KEY is injected as a runtime secret.
# A ChatGPT subscription does not provide API credentials or API billing.
PERSONALIZATION_ENABLED=false
PERSONALIZATION_PROVIDER=openai
# For Anthropic-compatible gateways: provider=anthropic, model=claude-opus-4-6,
# and API_BASE_URL=https://your-provider/v1. Legacy OPENAI_* variables still work.
PERSONALIZATION_API_KEY=
PERSONALIZATION_API_BASE_URL=
PERSONALIZATION_API_AUTH_SCHEME=x-api-key
PERSONALIZATION_MODEL=gpt-5.6-luna
PERSONALIZATION_MAX_RECIPIENTS=100
PERSONALIZATION_MAXIMUM_CONCURRENCY=16
PERSONALIZATION_REQUEST_TIMEOUT_SECONDS=60
PERSONALIZATION_LOG_LEVEL=INFO
OPENAI_API_KEY=
OPENAI_API_BASE_URL=https://api.openai.com/v1
RAY_WORKER_CPUS=2

# Authentication policy
AUTH_ACCESS_TOKEN_TTL=PT10M
AUTH_REFRESH_TOKEN_TTL=P14D
AUTH_MAX_LOGIN_FAILURES=5
AUTH_LOGIN_FAILURE_WINDOW=PT15M
AUTH_ISSUER=camel-arxiv
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAME_SITE=Strict

# Public ports
HTTP_PORT=8080
MAILPIT_WEB_PORT=8025
